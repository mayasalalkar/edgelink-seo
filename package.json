{
  "name": "edgelink-seo-automation-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack SEO Automation Dashboard with Next.js 14, BullMQ, Upstash Redis, Prisma (Supabase/Neon), Claude API, and Puppeteer PDF reports.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "worker": "node src/worker/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test:mocks": "node scripts/verify-pipeline.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.25.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "puppeteer": "^23.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
