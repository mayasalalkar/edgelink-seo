# ==============================================================================
# Edgelink SEO Automation Dashboard — Environment Variables (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# 1. Mock Toggle Switch (required by Section 2.2)
# Set true to run PageSpeed, GSC, DataForSEO, Twilio WhatsApp, and Email on mocks.
USE_MOCKS=true

# Optional: set true to also mock Anthropic Claude API even if ANTHROPIC_API_KEY is set.
# Leave false (default) when using a real Anthropic API key.
USE_MOCK_CLAUDE=false

# 2. Anthropic Claude API (Real preferred — $5 free starter credit at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# 3. PostgreSQL Database — Neon (recommended) or Supabase (Free Tier)
# For Supabase: DATABASE_URL uses connection pooler (port 6543, ?pgbouncer=true)
#               DIRECT_URL uses direct connection (port 5432) for Prisma migrations.
# For Neon:     Both can use the Neon pooled / direct connection strings.
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# 4. Upstash Redis — Serverless Redis for BullMQ (Free Tier: 500K commands/mo)
# Use the rediss:// TLS URL from your Upstash console.
REDIS_URL="rediss://default:your-upstash-password@your-endpoint.upstash.io:6379"

# 5. External Cron Scheduler (cron-job.org) Secret Header
# Send as header `x-cron-secret: <CRON_SECRET>` or `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET="replace-with-a-strong-random-secret"

# 6. Worker Configuration
WORKER_CONCURRENCY=2
REPORTS_DIR=/tmp/reports

# Set RUN_INLINE_WORKER=true ONLY if deploying on Vercel without a separate worker host.
# When running the dedicated Node.js worker (Render / Railway / Fly.io), keep false.
RUN_INLINE_WORKER=false
CRON_BATCH_SIZE=1

# 7. Optional Production External API Keys (used only when USE_MOCKS=false)
PAGESPEED_API_KEY=
GSC_ACCESS_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
